#!/usr/bin/env python3
"""
Eden Cheat Manager — Simplify cheat management for the Eden Switch emulator on Android.

Automates: Build ID extraction from logs → folder creation → ADB push to device.
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

# ── Constants ──────────────────────────────────────────────────────────────

LOCAL_BASE   = Path.home() / ".local" / "share" / "eden-cheats-manager"
REMOTE_BASE  = "/storage/emulated/0/Android/data/dev.eden.eden_emulator/files/load"
BUILD_ID_RE  = re.compile(r"build_id=([A-F0-9]{16,64}),\s*name=main")


# ── Helpers ────────────────────────────────────────────────────────────────

def check_adb():
    """Return (True, device_id) if ADB is working and a device is attached."""
    try:
        r = subprocess.run(["adb", "devices"], capture_output=True, text=True, timeout=10)
        devices = [l.split()[0] for l in r.stdout.strip().split("\n")[1:]
                   if l.strip() and "\tdevice" in l]
        return (True, devices[0]) if devices else (False, None)
    except FileNotFoundError:
        print("⚠  ADB not found. Install:  sudo pacman -S android-tools")
        return False, None
    except subprocess.TimeoutExpired:
        print("⚠  ADB timed out.")
        return False, None


def extract_bids(text):
    """Return list of (full_32, bid_16) tuples, de-duplicated."""
    seen = set()
    out = []
    for full in BUILD_ID_RE.findall(text):
        bid = full[:16]
        if bid not in seen:
            seen.add(bid)
            out.append((full, bid))
    return out


def open_editor(initial: str) -> str:
    """Open $EDITOR (or nano) for the user to enter / edit cheat codes."""
    editor = os.environ.get("EDITOR", "nano")
    with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
        f.write(initial + "\n# Lines starting with # are ignored\n")
        tmp = f.name
    try:
        subprocess.run([editor, tmp])
        text = Path(tmp).read_text()
    finally:
        Path(tmp).unlink(missing_ok=True)
    return "\n".join(l for l in text.split("\n") if not l.startswith("#"))


def pull_log():
    """Try to pull the Eden log from a connected Android device."""
    candidates = [
        "/sdcard/Android/data/dev.eden.eden_emulator/files/log/eden_log.txt",
        "/sdcard/Android/data/dev.eden.eden_emulator/files/log/eden_log.txt.old.txt",
        "/sdcard/eden.log",
    ]
    # also search under the Eden data dir
    try:
        r = subprocess.run(
            ["adb", "shell", "find", "/sdcard/Android/data/dev.eden.eden_emulator",
             "-name", "*.log", "-type", "f"],
            capture_output=True, text=True, timeout=8)
        for line in reversed(r.stdout.strip().split("\n")):
            candidates.insert(0, line.strip())
    except Exception:
        pass
    for remote in candidates:
        try:
            r = subprocess.run(["adb", "shell", "cat", remote],
                               capture_output=True, text=True, timeout=10)
            if r.returncode == 0 and "build_id=" in r.stdout:
                print(f"  ✓ Found log at: {remote}")
                return r.stdout
        except Exception:
            continue
    return None


# ── Commands ───────────────────────────────────────────────────────────────

def cmd_extract(args):
    """Extract Build IDs from an Eden log."""
    log_text = ""

    if args.adb:
        ok, dev = check_adb()
        if not ok: return 1
        log_text = pull_log()
        if not log_text:
            print("⚠  Could not pull log. Try --log PATH instead.")
            return 1
    elif args.log:
        p = Path(args.log)
        if not p.exists():
            print(f"✗  File not found: {args.log}")
            return 1
        log_text = p.read_text()
    else:
        print("✗  Specify --log PATH or --adb")
        return 1

    bids = extract_bids(log_text)
    if not bids:
        print("⚠  No Build IDs found. Make sure the log contains lines like:")
        print('   [timestamp] Loader ... build_id=XXXXXXXX, name=main')
        return 1

    print(f"\n┌{'─'*62}┐")
    print(f"│ {'Build ID (16-char)':<20} {'Full hash':<38} │")
    print(f"├{'─'*62}┤")
    for full, bid in bids:
        print(f"│ {bid:<20} {full:<38} │")
    print(f"└{'─'*62}┘")
    print(f"\n  Found {len(bids)} unique Build ID(s).  Use the 16-char version.")
    return 0


def create_cheat(title_id, build_id, name, hex_codes, base=None):
    """Create the folder structure and write the .txt cheat file."""
    base = Path(base or LOCAL_BASE)
    dest = base / title_id / name / "cheats"
    dest.mkdir(parents=True, exist_ok=True)
    file = dest / f"{build_id}.txt"
    file.write_text(hex_codes.strip() + "\n")
    return file


def cmd_create(args):
    """Create a cheat folder structure locally."""
    # ── get hex codes ──
    if args.code:
        hex_codes = args.code
    elif args.file:
        p = Path(args.file)
        if not p.exists():
            print(f"✗  File not found: {args.file}")
            return 1
        hex_codes = p.read_text()
    elif args.stdin:
        hex_codes = sys.stdin.read()
    else:
        hex_codes = open_editor(f"[{args.name}]")
        if not hex_codes.strip():
            print("✗  No cheat codes provided.")
            return 1

    # clean up
    lines = [l for l in hex_codes.strip().split("\n")
             if l.strip() and not l.startswith("#")]
    if not lines:
        print("✗  No valid hex codes found.")
        return 1

    file = create_cheat(args.title_id, args.build_id, args.name, "\n".join(lines),
                        base=args.output)
    print(f"✓  Created: {file}")
    print(f"   Title ID:  {args.title_id}")
    print(f"   Build ID:  {args.build_id}")
    print(f"   Name:      {args.name}")
    if not args.no_push:
        print(f"\n   Push:  eden-cheats-manager push -t {args.title_id} -n \"{args.name}\"")
    return 0


def cmd_push(args):
    """Push cheat files to Android via ADB."""
    ok, dev = check_adb()
    if not ok: return 1

    local_base = Path(args.local or LOCAL_BASE)
    title_dir  = local_base / args.title_id
    if not title_dir.exists():
        print(f"✗  No local cheats for {args.title_id}")
        return 1

    names = [args.name] if args.name else \
            [d.name for d in title_dir.iterdir() if d.is_dir()]

    pushed = 0
    for name in names:
        cheats_dir = title_dir / name / "cheats"
        if not cheats_dir.exists():
            continue
        remote_dir = f"{REMOTE_BASE}/{args.title_id}/{name}/cheats"
        subprocess.run(["adb", "shell", f"mkdir -p '{remote_dir}'"],
                       capture_output=True, timeout=10)
        for f in cheats_dir.glob("*.txt"):
            r = subprocess.run(["adb", "push", str(f), f"{remote_dir}/{f.name}"],
                               capture_output=True, text=True, timeout=15)
            if r.returncode == 0:
                pushed += 1
                print(f"  ✓  {name}/{f.name}")
            else:
                print(f"  ✗  {name}/{f.name}: {r.stderr.strip()}")

    print(f"\n✓  Pushed {pushed} file(s) for {args.title_id}")
    return 0


def cmd_list(args):
    """List installed cheats."""
    if args.adb:
        ok, dev = check_adb()
        if not ok: return 1
        base = REMOTE_BASE
        if args.title_id:
            r = subprocess.run(["adb", "shell", "ls", "-R", f"{base}/{args.title_id}"],
                               capture_output=True, text=True, timeout=10)
            print(r.stdout or f"No cheats for {args.title_id}")
        else:
            r = subprocess.run(["adb", "shell", "ls", base],
                               capture_output=True, text=True, timeout=10)
            print(r.stdout or "No cheats on device.")
    else:
        base = Path(args.local or LOCAL_BASE)
        if not base.exists():
            print("No local cheats yet.")
            return 0
        if args.title_id:
            td = base / args.title_id
            if not td.exists():
                print(f"No cheats for {args.title_id}")
                return 0
            print(f"\n  {args.title_id}/")
            for d in sorted(td.iterdir()):
                if d.is_dir():
                    files = list((d / "cheats").glob("*.txt")) if (d / "cheats").exists() else []
                    print(f"    📁 {d.name}/  ({len(files)} file(s))")
                    for f in files:
                        print(f"       📄 {f.name}  ({f.stat().st_size} B)")
        else:
            print("\nAll local cheats:")
            any_found = False
            for td in sorted(base.iterdir()):
                if td.is_dir():
                    any_found = True
                    count = sum(1 for d in td.iterdir() if d.is_dir())
                    print(f"  📁 {td.name}/  ({count} cheat(s))")
            if not any_found:
                print("  (none)")


def cmd_wizard(args):
    """Interactive step-by-step setup."""
    print("\n╔══════════════════════════════════════════════════╗")
    print("║       Eden Cheat Manager — Setup Wizard          ║")
    print("╚══════════════════════════════════════════════════╝\n")

    # 1. Title ID
    print("── Step 1: Title ID ──")
    print("  Tip: Long-press game in Eden → Info → Program ID")
    tid = input("  Title ID (16 hex): ").strip().upper()
    if not re.match(r"^[A-F0-9]{16}$", tid):
        print("✗  Must be 16 hex characters."); return 1

    # 2. Build ID
    print("\n── Step 2: Build ID ──")
    print("  1 = Pull from device (ADB)")
    print("  2 = Parse local log file")
    print("  3 = Enter manually")
    choice = input("  Choice (1/2/3): ").strip()
    bid = None

    if choice == "1":
        ok, _ = check_adb()
        if ok:
            text = pull_log()
            if text:
                bids = extract_bids(text)
                if bids:
                    for i, (full, b) in enumerate(bids, 1):
                        print(f"    {i}. {b}")
                    sel = input(f"  Pick (1-{len(bids)}): ").strip()
                    try:
                        bid = bids[int(sel)-1][1]
                    except (ValueError, IndexError):
                        pass
    elif choice == "2":
        path = input("  Log file path: ").strip()
        if path and Path(path).exists():
            bids = extract_bids(Path(path).read_text())
            if bids:
                for i, (full, b) in enumerate(bids, 1):
                    print(f"    {i}. {b}")
                sel = input(f"  Pick (1-{len(bids)}): ").strip()
                try:
                    bid = bids[int(sel)-1][1]
                except (ValueError, IndexError):
                    pass
    elif choice == "3":
        bid = input("  Build ID (16 hex): ").strip().upper()

    if not bid or not re.match(r"^[A-F0-9]{16}$", bid):
        print("✗  Invalid Build ID."); return 1
    print(f"  ✓  Build ID: {bid}")

    # 3. Cheat name
    print("\n── Step 3: Cheat Name ──")
    name = input("  Name (e.g. 'Infinite HP'): ").strip()
    if not name:
        print("✗  Name required."); return 1

    # 4. Hex codes
    print("\n── Step 4: Hex Codes ──")
    print("  1 = Paste now (Ctrl+D to finish)")
    print("  2 = Open editor")
    print("  3 = Read from file")
    choice = input("  Choice (1/2/3): ").strip()

    hc = ""
    if choice == "1":
        print("  Paste codes (Ctrl+D or empty line to end):")
        lines = []
        try:
            while True:
                line = input()
                if not line: break
                lines.append(line)
        except EOFError:
            pass
        hc = "\n".join(lines)
    elif choice == "2":
        hc = open_editor(f"[{name}]")
    elif choice == "3":
        p = input("  File path: ").strip()
        if p and Path(p).exists():
            hc = Path(p).read_text()

    if not hc.strip():
        print("✗  No codes provided."); return 1

    # 5. Create + push
    print("\n── Step 5: Install ──")
    file = create_cheat(tid, bid, name, hc)
    print(f"  ✓  Created: {file}")

    if input("\n  Push to device? (y/n): ").strip().lower() == "y":
        ok, _ = check_adb()
        if ok:
            remote = f"{REMOTE_BASE}/{tid}/{name}/cheats"
            subprocess.run(["adb", "shell", f"mkdir -p '{remote}'"],
                           capture_output=True, timeout=10)
            r = subprocess.run(["adb", "push", str(file), f"{remote}/{file.name}"],
                               capture_output=True, text=True, timeout=15)
            if r.returncode == 0:
                print("  ✓  Pushed!  Now in Eden: long-press → Add-ons → Install → Mods and cheats")

    print("\n✓  All done!")
    return 0


# ── Entry point ────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="Eden Cheat Manager — simplify cheat management for Eden emulator",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  eden-cheats-manager extract --adb                  # Pull log & show Build IDs
  eden-cheats-manager extract --log eden.log         # Parse local log file
  eden-cheats-manager wizard                         # Interactive setup
  eden-cheats-manager create -t 0100A6301214E000 -b E7E1382D5EB931B0 \\
      -n "Max Money" -c "04000000 00C88A70 3B9AC9FF"
  eden-cheats-manager create -t ... -b ... -n ... -f cheat.txt   # read from file
  eden-cheats-manager push -t 0100A6301214E000 -n "Max Money"
  eden-cheats-manager list                            # local cheats
  eden-cheats-manager list --adb                      # cheats on device
        """)

    sp = parser.add_subparsers(dest="cmd", help="Command")

    # extract
    p = sp.add_parser("extract", help="Extract Build IDs from Eden log")
    p.add_argument("--adb", action="store_true", help="Pull log from device")
    p.add_argument("--log", help="Local log file path")

    # create
    p = sp.add_parser("create", help="Create cheat folder structure")
    p.add_argument("-t", "--title-id", required=True)
    p.add_argument("-b", "--build-id", required=True)
    p.add_argument("-n", "--name", required=True)
    p.add_argument("-c", "--code")
    p.add_argument("-f", "--file")
    p.add_argument("--stdin", action="store_true")
    p.add_argument("-o", "--output")
    p.add_argument("--no-push", action="store_true")

    # push
    p = sp.add_parser("push", help="Push cheats to Android device (ADB)")
    p.add_argument("-t", "--title-id", required=True)
    p.add_argument("-n", "--name")
    p.add_argument("-l", "--local")

    # list
    p = sp.add_parser("list", help="List installed cheats")
    p.add_argument("-t", "--title-id")
    p.add_argument("--adb", action="store_true")
    p.add_argument("-l", "--local")

    # wizard
    sp.add_parser("wizard", help="Interactive setup wizard")

    args = parser.parse_args()

    cmds = {
        "extract": cmd_extract, "create": cmd_create,
        "push": cmd_push, "list": cmd_list, "wizard": cmd_wizard,
    }

    if not args.cmd:
        parser.print_help()
        return 0

    return cmds[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
