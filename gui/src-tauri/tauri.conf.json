{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eden Cheats Manager",
  "version": "0.2.0-rc.1",
  "identifier": "dev.eden.cheats-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "EDC",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "linux": {
      "deb": { "desktopTemplate": "edc.desktop.hbs" },
      "rpm": { "desktopTemplate": "edc.desktop.hbs" }
    },
    "android": { "versionCode": 2001 },
    "windows": { "wix": { "version": "0.2.0.1" } },
    "macOS": { "bundleVersion": "0.2.1" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../../titles.db", "../../cheats.db"]
  }
}
